{
    "$defs": {
        "AccesControlDefinition": {
            "description": "Access control definition for a single access group",
            "properties": {
                "override": {
                    "anyOf": [
                        {
                            "items": {
                                "type": "string"
                            },
                            "type": "array",
                            "uniqueItems": true
                        },
                        {
                            "items": {
                                "$ref": "#/$defs/AccessControlEnum"
                            },
                            "type": "array",
                            "uniqueItems": true
                        },
                        {
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "Override the default access control for the given group, if not specified it will not override",
                    "title": "Override"
                },
                "default": {
                    "anyOf": [
                        {
                            "items": {
                                "type": "string"
                            },
                            "type": "array",
                            "uniqueItems": true
                        },
                        {
                            "items": {
                                "$ref": "#/$defs/AccessControlEnum"
                            },
                            "type": "array",
                            "uniqueItems": true
                        },
                        {
                            "type": "string"
                        }
                    ],
                    "description": "Default access control for the given group",
                    "title": "Default"
                }
            },
            "title": "AccesControlDefinition",
            "type": "object"
        },
        "AccessControlCollection": {
            "additionalProperties": {
                "anyOf": [
                    {
                        "$ref": "#/$defs/AccesControlDefinition"
                    },
                    {
                        "items": {
                            "type": "string"
                        },
                        "type": "array",
                        "uniqueItems": true
                    },
                    {
                        "type": "string"
                    }
                ]
            },
            "title": "AccessControlCollection",
            "type": "object"
        },
        "AccessControlEnum": {
            "description": "Access control enum, list all the possible access control items\nNeeds to match the odin definitions in the c library",
            "enum": [
                1,
                2,
                3,
                4
            ],
            "title": "AccessControlEnum",
            "type": "integer"
        },
        "ArrayParameterModel": {
